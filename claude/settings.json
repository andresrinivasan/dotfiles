{
  "awsCredentialExport": "aws configure export-credentials --profile bedrock --format process",
  "awsAuthRefresh": "aws sso login --profile bedrock",
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "eu-west-1",
    "AWS_PROFILE": "sandbox",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "eu.anthropic.claude-sonnet-4-5-20250929-v1:0",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "eu.anthropic.claude-opus-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "eu.anthropic.claude-haiku-4-5-20251001-v1:0"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote -v)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws sts decode-authorization-message:*)",
      "Bash(aws sts get-access-key-info:*)",
      "Bash(aws cloudformation describe-:*)",
      "Bash(aws cloudformation get-:*)",
      "Bash(aws cloudformation list-:*)",
      "Bash(aws lambda get-:*)",
      "Bash(aws lambda list-:*)",
      "Bash(aws logs describe-:*)",
      "Bash(aws logs get-:*)",
      "Bash(aws logs filter-log-events:*)",
      "Bash(aws logs tail:*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws s3api list-:*)",
      "Bash(aws s3api get-:*)",
      "Bash(aws s3api head-:*)",
      "Bash(aws ec2 describe-:*)",
      "Bash(aws iam get-:*)",
      "Bash(aws iam list-:*)",
      "Bash(aws ssm describe-:*)",
      "Bash(aws ssm get-:*)",
      "Bash(aws ssm list-:*)",
      "Bash(aws secretsmanager describe-:*)",
      "Bash(aws secretsmanager list-:*)",
      "Bash(aws codepipeline get-:*)",
      "Bash(aws codepipeline list-:*)",
      "Bash(aws codebuild batch-get-:*)",
      "Bash(aws codebuild list-:*)",
      "Bash(aws dynamodb describe-:*)",
      "Bash(aws dynamodb list-:*)",
      "Bash(aws sns get-:*)",
      "Bash(aws sns list-:*)",
      "Bash(aws cognito-idp describe-:*)",
      "Bash(aws cognito-idp get-:*)",
      "Bash(aws cognito-idp list-:*)",
      "Bash(aws ecr describe-:*)",
      "Bash(aws ecr get-:*)",
      "Bash(aws ecr list-:*)",
      "Bash(aws ecr batch-get-:*)",
      "Bash(aws ecs describe-:*)",
      "Bash(aws ecs list-:*)",
      "Bash(aws codebuild batch-get-builds:*)",
      "Bash(aws codebuild batch-get-projects:*)",
      "Bash(aws ec2 get-:*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws service-quotas get-:*)",
      "Bash(aws service-quotas list-:*)",
      "Bash(aws sso-admin describe-:*)",
      "Bash(aws sso-admin list-:*)",
      "Bash(aws organizations describe-:*)",
      "Bash(aws organizations list-:*)",
      "Bash(aws user-subscriptions list-:*)",
      "Bash(aws configure list)",
      "Bash(aws configure list-profiles)",
      "Bash(aws configure get:*)",
      "Bash(aws sso list-:*)",
      "Bash(aws help:*)",
      "Bash(aws --version)",
      "Bash(sort:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "mcp__se_demo_3b__read_file",
      "mcp__se_demo_3b__edit_file",
      "mcp__se_demo_3b__run_step",
      "mcp__se_demo_3b__get_workflow",
      "mcp__se_demo_3b__list_spaces",
      "mcp__se_demo_3b__list_workflows",
      "mcp__se_demo_3b__list_files",
      "mcp__se_demo_3b__list_versions",
      "mcp__se_demo_3b__get_run_executions",
      "mcp__se_demo_3b__list_runs",
      "mcp__se_demo_3b__get_run",
      "mcp__se_demo_3b__get_execution_output",
      "Bash(aws logs *)",
      "Bash(uvx black *)",
      "Bash(python3 -m py_compile central_lambda_source/tasks/hello_task.py)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-venv-exec.py",
            "timeout": 10,
            "statusMessage": "Checking for direct .venv/bin execution"
          }
        ]
      }
    ]
  },
  "plansDirectory": ".claude/plans",
  "theme": "custom:solarized-light-custom"
}
